@* Change-password and log-out sections of the Settings page.
   Shared by the student and organization dashboards. Front-end only: nothing is saved. *@

<!-- Change password -->
<section class="settings-section">
    <h2 class="settings-section__title">Change Password</h2>
    <form class="settings-card" method="post" asp-action="Settings">
        <partial name="_SettingsRow" model='new SettingsRowViewModel("currentPassword", "Current Password", "password", "eye", "current-password")' />
        <partial name="_SettingsRow" model='new SettingsRowViewModel("newPassword", "New Password", "password", "eye", "new-password")' />
        <partial name="_SettingsRow" model='new SettingsRowViewModel("confirmNewPassword", "Confirm New Password", "password", "eye", "new-password")' />

        <div class="settings-card__actions">
            <button type="submit" class="btn btn--gold btn--sm">
                @Html.Icon("save")
                <span>Save Changes</span>
            </button>
        </div>
    </form>
</section>

<!-- Log out -->
<section class="settings-section">
    <h2 class="settings-section__title">Log Out</h2>
    <div class="settings-card settings-card--inline">
        <p>Are you sure you want to log-out?</p>
        <a class="btn btn--danger btn--sm" asp-controller="Account" asp-action="SignIn">
            @Html.Icon("log-out")
            <span>Log Out</span>
        </a>
    </div>
</section>
