@{
    ViewData["Title"] = "Settings";
    ViewData["ActiveNav"] = "Settings";
}

<header class="page-head">
    <h1 class="page-head__title">Settings</h1>
    <p class="page-head__text">Manage your account.</p>
</header>

<section class="page-body settings">

    @* Front-end only: none of these forms save anything yet. *@

    <!-- Profile -->
    <section class="settings-section">
        <h2 class="settings-section__title">Profile</h2>
        <form class="settings-card" method="post" asp-action="Settings">
            <partial name="_SettingsRow" model='new SettingsRowViewModel("fullName", "Full Name", TrailingIcon: "pencil", Autocomplete: "name")' />
            <partial name="_SettingsRow" model='new SettingsRowViewModel("email", "Email", "email", "pencil", "email")' />

            <div class="settings-card__actions">
                <button type="submit" class="btn btn--gold btn--sm">
                    @Html.Icon("save")
                    <span>Save Changes</span>
                </button>
            </div>
        </form>
    </section>

    <partial name="_PasswordAndLogout" />

</section>
